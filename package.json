{
  "name": "crm_zoho_books",
  "version": "1.0.0",
  "description": "Enterprise CRM and Zoho Books Direct Integration",
  "main": "server/src/server.js",
  "scripts": {
    "start": "node server/src/server.js",
    "build": "npm run build --prefix client",
    "dev": "concurrently -k -p \"[{name}]\" -n \"SERVER,CLIENT\" -c \"blue,magenta\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node server/src/server.js",
    "dev:client": "npm run dev --prefix client",
    "worker": "node server/src/worker.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "test:worker": "node --test tests/worker.test.js",
    "test:step2-1": "node scripts/simulateHubSpotWebhook.js",
    "test:step3-1": "node scripts/testCustomerMatching.js",
    "test:step3-2": "node scripts/verifySalesOrderWorkflow.js",
    "test:step3-3": "node --test tests/phase3_invoice.test.js",
    "test:step3-4": "node --test tests/phase3_orchestration.test.js",
    "test:step3-5": "node --test tests/phase3_step5_milestones.test.js",
    "test:phase4": "node --test tests/phase4_payments.test.js",
    "test:phase5": "node --test tests/phase5_dashboard.test.js",
    "seed": "node scripts/seedDataset.js",
    "setup:hubspot": "node scripts/setupHubSpotProperties.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "mongoose": "^9.0.0",
    "morgan": "^1.10.1"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.2.2"
  }
}
