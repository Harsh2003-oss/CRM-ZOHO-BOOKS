# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/crm_zoho_db?retryWrites=true&w=majority

# Zoho Books Configuration
ZOHO_BOOKS_DOMAIN=com
ZOHO_BOOKS_ORGANIZATION_ID=your_org_id_here
ZOHO_CLIENT_ID=your_zoho_client_id
ZOHO_CLIENT_SECRET=your_zoho_client_secret
ZOHO_REFRESH_TOKEN=your_zoho_refresh_token_here

# HubSpot CRM Configuration
HUBSPOT_ACCESS_TOKEN=pat-na1-your_token_here

