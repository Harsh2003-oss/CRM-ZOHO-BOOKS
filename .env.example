# ==============================================================================
# CRM & Zoho Books Integration Environment Configuration
# Copy this file to .env and fill in your actual credentials.
# NEVER commit .env to source control!
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (MongoDB Atlas connection string)
# Format: mongodb+srv://<db_username>:<db_password>@<cluster_domain>/crm_zoho_db?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.xxxxx.mongodb.net/crm_zoho_db?retryWrites=true&w=majority

# Zoho Books Configuration
# Regional domain: 'in' for India, 'com' for US, 'eu' for Europe
ZOHO_BOOKS_DOMAIN=in
ZOHO_BOOKS_ORGANIZATION_ID=your_zoho_org_id_here
ZOHO_CLIENT_ID=your_zoho_client_id_here
ZOHO_CLIENT_SECRET=your_zoho_client_secret_here
ZOHO_REFRESH_TOKEN=your_zoho_permanent_refresh_token_here

# Zoho Books UAE VAT / Base Currency Identifiers (Configured automatically or via settings)
ZOHO_UAE_VAT_TAX_ID=your_vat_tax_id_here
ZOHO_AED_CURRENCY_ID=your_aed_currency_id_here

# HubSpot CRM Configuration
# Service Key / Private App token starting with 'pat-...'
HUBSPOT_ACCESS_TOKEN=pat-na2-your_access_token_here
