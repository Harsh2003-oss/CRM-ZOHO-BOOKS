# ==============================================================================
# CRM & Zoho Books Integration Environment Configuration
# Copy this file to .env and fill in your actual credentials.
# NEVER commit .env to source control!
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
# Reverse Proxy Trust Configuration:
# In production, specify the exact proxy hop count or trusted CIDR:
# - '1' for single reverse proxy / cloud load balancer (e.g. AWS ALB, Render, Railway, Heroku)
# - '2' for Cloudflare + cloud load balancer
# - 'loopback' for local proxy
# - 'false' for direct internet exposure (no proxy)
# Defaults to 'false' in production if unset (fails safe); defaults to 'loopback' in development.
TRUST_PROXY=1

# Database (MongoDB Atlas connection string)
# Format: mongodb+srv://<db_username>:<db_password>@<cluster_domain>/crm_zoho_db?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.xxxxx.mongodb.net/crm_zoho_db?retryWrites=true&w=majority

# Zoho Books Configuration
# Regional domain: 'in' for India, 'com' for US, 'eu' for Europe
ZOHO_BOOKS_DOMAIN=in
ZOHO_BOOKS_ORGANIZATION_ID=your_zoho_org_id_here
ZOHO_CLIENT_ID=your_zoho_client_id_here
ZOHO_CLIENT_SECRET=your_zoho_client_secret_here
ZOHO_REFRESH_TOKEN=your_zoho_permanent_refresh_token_here

# Operator Action Center & Webhook Authentication
OPERATOR_API_KEY=your_secure_operator_api_key_here
ZOHO_WEBHOOK_SECRET=your_zoho_webhook_token_secret_here

# Zoho Books UAE VAT / Base Currency Identifiers (Configured automatically or via settings)
# Set VAT_PERCENTAGE=0 to disable VAT line items completely (e.g. for Falcon Technologies India edition test)
# If unset, defaults to 5.0%
VAT_PERCENTAGE=0
ZOHO_UAE_VAT_TAX_ID=your_vat_tax_id_here
ZOHO_AED_CURRENCY_ID=your_aed_currency_id_here

# Dedicated Queue Worker Configuration
# Safe defaults: Worker disabled by default, requires explicit allowlist
WORKER_ENABLED=false
WORKER_REQUIRE_ALLOWLIST=true
WORKER_ALLOWED_EVENT_IDS=hs_sim_novatech_001
WORKER_IGNORE_EVENT_IDS=hs_manual_test_01

# Product Catalog Mapping & Public Ingress Configuration
# Set DEFAULT_ZOHO_ITEM_ID to specify a verified default catalog item for generic service contracts
DEFAULT_ZOHO_ITEM_ID=your_zoho_item_id_here
REQUIRE_PRODUCT_MAPPING=false
# Run dedicated ingress gateway on a separate port or enable webhook-only mode
INGRESS_PORT=5001
WEBHOOK_INGRESS_ONLY=false

# HubSpot CRM Configuration
# Service Key / Private App token starting with 'pat-...'
HUBSPOT_ACCESS_TOKEN=pat-na2-your_access_token_here
# HubSpot App Client Secret (used for HubSpot Webhook Signature v3 verification)
HUBSPOT_CLIENT_SECRET=your_hubspot_app_client_secret_here
